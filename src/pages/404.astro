---
import SiteLayout from "@layouts/SiteLayout.astro"
---

<SiteLayout title="Página no encontrada" description="Esta página no existe.">
  <section class="nf">
    <h1 class="nf-title" aria-label="404"><span data-split data-wave>404</span></h1>
    <p class="nf-copy">Esta página no existe o cambió de dirección.</p>
    <div class="nf-actions">
      <a class="pill pill--solid" href="/" data-magnetic>Ir al inicio</a>
      <a class="pill" href="/search" data-magnetic>Buscar en el sitio</a>
    </div>
  </section>
</SiteLayout>
