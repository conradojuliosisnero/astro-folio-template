---
import { getCollection } from "astro:content"
import SiteLayout from "@layouts/SiteLayout.astro"
import PageHero from "@components/PageHero.astro"
import { BLOG } from "@consts"
import { formatDate } from "@lib/utils"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

// Etiquetas ordenadas por cuántos posts tienen
const counts = new Map<string, number>()
posts.forEach((p) => p.data.tags.forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1)))
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([t]) => t)
---

<SiteLayout title="Blog" description={BLOG.DESCRIPTION}>
  <PageHero
    title="Blog"
    tone="mint"
    intro={`${posts.length} artículos sobre desarrollo web, herramientas y lo que voy aprendiendo.`}
  >
    <div class="filters" role="group" aria-label="Filtrar artículos por tema" data-filter-group="blog">
      <button type="button" class="chip" aria-pressed="true" data-filter="all">Todos</button>
      {tags.map((t) => (
        <button type="button" class="chip" aria-pressed="false" data-filter={t}>{t}</button>
      ))}
    </div>
  </PageHero>

  <section class="plist-wrap">
    <ul class="plist" data-filter-list="blog">
      {posts.map((post) => (
        <li class="plist-item" data-tags={post.data.tags.join("|")}>
          <a class="prow" href={`/blog/${post.slug}`} data-cursor="Leer">
            <span class="prow-date">{formatDate(post.data.date)}</span>
            <span class="prow-main">
              <span class="prow-title">{post.data.title}</span>
              <span class="prow-summary">{post.data.summary}</span>
            </span>
            <span class="prow-tags">
              {post.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="empty" data-filter-empty="blog" hidden>No hay artículos con ese tema.</p>
  </section>
</SiteLayout>
