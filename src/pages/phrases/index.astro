---
import { getCollection } from "astro:content"
import SiteLayout from "@layouts/SiteLayout.astro"
import PageHero from "@components/PageHero.astro"
import { PHRASES } from "@consts"
import { phraseText } from "@lib/utils"

const phrases = (await getCollection("phrases"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const tones = ["peri", "mint", "peach", "butter", "lilac", "paper"]
---

<SiteLayout title="Frases" description={PHRASES.DESCRIPTION}>
  <PageHero
    title="Frases"
    tone="peach"
    intro={`${phrases.length} frases que me acompañan. Una nueva casi todos los días.`}
  />

  <section class="quotes-wrap">
    <ul class="quotes">
      {phrases.map((p, i) => (
        <li class="quotes-item" data-reveal>
          <a class={`quote quote--${tones[i % tones.length]}`} href={`/phrases/${p.slug}`} data-cursor="Ver" data-tilt>
            <span class="quote-text">{phraseText(p.body)}</span>
            <span class="quote-meta">{p.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
