---
import { type CollectionEntry, getCollection } from "astro:content"
import SiteLayout from "@layouts/SiteLayout.astro"
import PageHero from "@components/PageHero.astro"
import { formatDate } from "@lib/utils"
import { SITE } from "@consts"

export async function getStaticPaths() {
  const docs = await getCollection("legal")
  return docs.map((doc) => ({
    params: { slug: doc.slug },
    props: doc,
  }))
}

type Props = CollectionEntry<"legal">
const doc = Astro.props
const { title, date } = doc.data
const { Content } = await doc.render()
---

<SiteLayout title={title} description={`${title} de ${SITE.TITLE}`}>
  <PageHero title={title} tone="butter" intro={`Última actualización: ${formatDate(date)}`} />
  <div class="abody">
    <article class="prose-site" data-article>
      <Content />
    </article>
  </div>
</SiteLayout>
