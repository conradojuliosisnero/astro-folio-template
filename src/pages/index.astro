---
import { getCollection } from "astro:content"
import HomeLayout from "@layouts/HomeLayout.astro"
import { SITE, SOCIALS } from "@consts"

const work = (await getCollection("work")).sort(
  (a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime()
)

// Proyectos con demo o repo, los más recientes primero
const projects = (await getCollection("projects"))
  .filter((p) => !p.data.draft && (p.data.demoUrl || p.data.repoUrl))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 8)

const totalProjects = (await getCollection("projects")).filter((p) => !p.data.draft).length

const start = new Date("2023-01-01")
const years = Math.floor((Date.now() - start.getTime()) / (1000 * 60 * 60 * 24 * 365.25))

function formatDate(input: Date | string) {
  if (typeof input === "string") return input
  return input.toLocaleDateString("es-CO", { month: "short", year: "numeric" })
}

const kindLabel: Record<string, string> = {
  Project: "Proyecto",
  Component: "Componente",
  Freelance: "Freelance",
}

const stack = ["React", "Next.js", "TypeScript", "JavaScript", "Astro", "Tailwind", "CSS", "Zustand", "Redux", "Python", "Django", "Git"]

const email = SOCIALS.find((s) => s.NAME === "Email")
const github = SOCIALS.find((s) => s.NAME === "Github")
const linkedin = SOCIALS.find((s) => s.NAME === "LinkedIn")
---

<HomeLayout title="Inicio" description={SITE.DESCRIPTION}>
  <div class="cursor" aria-hidden="true"><span class="cursor-label">Abrir</span></div>

  <header class="hnav">
    <a href="/" class="hnav-brand" data-magnetic>Julio Conrado</a>
    <nav aria-label="Principal" class="hnav-links">
      <a href="#trabajo">Trabajo</a>
      <a href="#proyectos">Proyectos</a>
      <a href="/blog">Blog</a>
      <a href="/phrases">Frases</a>
      <a href="#contacto" class="hnav-cta" data-magnetic>Contacto</a>
    </nav>
  </header>

  <main class="home">
    <!-- HERO -->
    <section class="hero" id="inicio">
      <div class="hero-inner">
        <p class="hero-hello" data-scramble>Hola, soy</p>
        <h1 class="hero-name" aria-label="Julio Conrado">
          <span class="hero-line" data-split>Julio</span>
          <span class="hero-line hero-line--out" data-split>Conrado</span>
        </h1>
        <div class="hero-foot">
          <p class="hero-role">Frontend Engineer. Construyo interfaces con React, Next.js y TypeScript.</p>
          <a href="#trabajo" class="hero-scroll" data-magnetic>
            <span>Baja</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- SOBRE MÍ -->
    <section class="about">
      <p class="about-text" data-words>
        Llevo {years} años convirtiendo diseños en código de alta calidad. Trabajo con React, Next.js y frameworks de CSS para crear interfaces atractivas y responsivas, y últimamente también me meto con el backend en Django. He publicado {totalProjects} proyectos y me gusta trabajar en equipo hasta que todo encaja.
      </p>
    </section>

    <!-- STACK -->
    <section class="stack" aria-label="Tecnologías que uso">
      <div class="stack-track">
        {[0, 1].map(() => (
          <ul class="stack-list">
            {stack.map((s) => <li>{s}</li>)}
          </ul>
        ))}
      </div>
    </section>

    <!-- EXPERIENCIA -->
    <section class="work" id="trabajo">
      <div class="work-head">
        <h2 class="section-title" data-split>Experiencia</h2>
        <div class="work-progress" aria-hidden="true"><span></span></div>
      </div>
      <ol class="work-list">
        {work.map((job) => (
          <li class="job">
            <a class="job-row" href="/work">
              <span class="job-dates">{formatDate(job.data.dateStart)} – {formatDate(job.data.dateEnd)}</span>
              <span class="job-company">{job.data.company === "NA" ? "Proyecto independiente" : job.data.company}</span>
              <span class="job-role" data-role>{job.data.role}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- PROYECTOS (scroll horizontal) -->
    <section class="projects" id="proyectos">
      <div class="projects-pin">
        <div class="projects-head">
          <h2 class="section-title section-title--light" data-split>Proyectos</h2>
          <a href="/projects" class="projects-all" data-magnetic>Ver los {totalProjects}</a>
        </div>
        <div class="projects-track">
          {projects.map((p) => {
            const href = p.data.demoUrl ?? p.data.repoUrl
            return (
              <a class="pcard" href={href} target="_blank" rel="noopener" data-cursor="Abrir">
                <span class="pcard-glyph" aria-hidden="true">{p.data.title.charAt(0)}</span>
                <span class="pcard-meta">{kindLabel[p.data.summary] ?? p.data.summary}, {p.data.date.getFullYear()}</span>
                <span class="pcard-title">{p.data.title}</span>
                <span class="pcard-link">{p.data.demoUrl ? "Ver demo" : "Ver código"}</span>
              </a>
            )
          })}
        </div>
      </div>
    </section>

    <!-- CERTIFICACIÓN -->
    <section class="cert">
      <p class="cert-kicker">Certificado en 2026</p>
      <p class="cert-name" data-words>SAP Certified – Implementation Consultant – SAP Sales Cloud Version 2</p>
    </section>

    <!-- CONTACTO -->
    <section class="contact" id="contacto">
      <h2 class="contact-title" aria-label="Hablemos">
        <span data-split data-wave>Hablemos</span>
      </h2>
      <p class="contact-copy">Escríbeme para un proyecto, una vacante o solo para saludar.</p>
      {email && (
        <a class="contact-mail" href={email.HREF} data-magnetic data-cursor="Escribir">{email.TEXT}</a>
      )}
      <ul class="contact-socials">
        {github && <li><a href={github.HREF} target="_blank" rel="noopener" data-magnetic>GitHub</a></li>}
        {linkedin && <li><a href={linkedin.HREF} target="_blank" rel="noopener" data-magnetic>LinkedIn</a></li>}
        <li><a href="/blog" data-magnetic>Blog</a></li>
      </ul>
      <footer class="hfoot">
        <span>© {new Date().getFullYear()} Julio Conrado</span>
        <span>Hecho con Astro y GSAP</span>
      </footer>
    </section>
  </main>

  <script>
    import { initHome } from "../scripts/home"
    document.addEventListener("astro:page-load", initHome)
  </script>
</HomeLayout>
