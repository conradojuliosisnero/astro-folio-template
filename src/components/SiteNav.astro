---
const { pathname } = Astro.url
const section = "/" + (pathname.match(/[^/]+/g)?.[0] ?? "")

const links = [
  { text: "Trabajo", href: "/work" },
  { text: "Proyectos", href: "/projects" },
  { text: "Blog", href: "/blog" },
  { text: "Frases", href: "/phrases" },
]
---

<header class="hnav">
  <a href="/" class="hnav-brand" data-magnetic>Julio Conrado</a>
  <nav aria-label="Principal" class="hnav-links">
    {links.map((l) => (
      <a href={l.href} aria-current={section === l.href ? "page" : undefined}>{l.text}</a>
    ))}
    <a href="/search" class="hnav-icon" aria-label="Buscar" aria-current={section === "/search" ? "page" : undefined}>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    </a>
    <a href="/#contacto" class="hnav-cta" data-magnetic>Contacto</a>
    <button type="button" class="hnav-menu" aria-expanded="false" aria-controls="mmenu">Menú</button>
  </nav>
</header>

<div class="mmenu" id="mmenu" hidden>
  <nav aria-label="Menú móvil">
    <ul class="mmenu-list">
      <li><a href="/">Inicio</a></li>
      {links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
      <li><a href="/search">Buscar</a></li>
      <li><a href="/#contacto">Contacto</a></li>
    </ul>
  </nav>
</div>
